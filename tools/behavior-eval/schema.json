{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "checks", "nextSafeAction"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["COMPLETE", "BLOCKED", "PENDING_USER_ACTION", "FAILED", "SKIPPED"]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "result", "evidence"],
        "properties": {
          "name": {"type": "string"},
          "result": {"type": "string", "enum": ["pass", "fail", "skipped", "unavailable", "pending"]},
          "evidence": {"type": "string"}
        }
      }
    },
    "nextSafeAction": {"type": "string"}
  }
}
